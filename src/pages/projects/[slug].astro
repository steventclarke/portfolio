---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const showDrafts = import.meta.env.PUBLIC_SHOW_DRAFTS === 'true';
  const projects = await getCollection('projects', ({ data }) => showDrafts || !data.draft);

  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, showDraftBadge: showDrafts && entry.data.draft },
  }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
  showDraftBadge: boolean;
}

const { entry, showDraftBadge } = Astro.props;
const { Content } = await render(entry);
---

<ProjectLayout entry={entry} showDraftBadge={showDraftBadge}>
  <Content />
</ProjectLayout>

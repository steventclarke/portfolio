---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects" description="Featured projects by Steven Clarke - Iron Altar, Squat Monster, Media Inspector, and the Portfolio Website.">
  <section class="space-y-8">
    <header class="space-y-4">
      <p class="text-sm font-medium uppercase tracking-[0.3em] text-teal-600 dark:text-teal-400">Projects</p>
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Work in progress, documented well.</h1>
      <p class="max-w-3xl text-lg text-slate-600 dark:text-slate-300">
        Four projects that demonstrate practical engineering, from fitness to computer vision to media metadata to building this site itself.
      </p>
    </header>
    <div class="grid gap-6 md:grid-cols-2">
      <article class="rounded-2xl border border-slate-200 p-6 transition hover:-translate-y-1 hover:shadow-lg dark:border-slate-800">
        <p class="text-sm font-medium text-teal-600 dark:text-teal-400">Strength training</p>
        <h2 class="mt-2 text-2xl font-semibold">Iron Altar</h2>
        <p class="mt-2 text-slate-600 dark:text-slate-300">A strength-training application focused on clear programming and tracking.</p>
        <div class="mt-4 flex flex-wrap gap-3 text-sm">
          <a class="text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300" href="/projects/iron-altar">Case study</a>
          <a class="text-slate-600 hover:text-teal-600 dark:text-slate-300 dark:hover:text-teal-400" href="https://github.com/steventclarke/iron-altar">GitHub</a>
          <a class="text-slate-600 hover:text-teal-600 dark:text-slate-300 dark:hover:text-teal-400" href="https://ironaltar.stevenclarke.dev">Demo</a>
        </div>
      </article>
      <article class="rounded-2xl border border-slate-200 p-6 transition hover:-translate-y-1 hover:shadow-lg dark:border-slate-800">
        <p class="text-sm font-medium text-teal-600 dark:text-teal-400">Computer vision</p>
        <h2 class="mt-2 text-2xl font-semibold">Squat Monster</h2>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Bar-path analysis using computer vision to analyze barbell lifts.</p>
        <div class="mt-4 flex flex-wrap gap-3 text-sm">
          <a class="text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300" href="/projects/squat-monster">Case study</a>
          <a class="text-slate-600 hover:text-teal-600 dark:text-slate-300 dark:hover:text-teal-400" href="https://github.com/steventclarke/squat-monster">GitHub</a>
          <a class="text-slate-600 hover:text-teal-600 dark:text-slate-300 dark:hover:text-teal-400" href="https://squatmonster.stevenclarke.dev">Demo</a>
        </div>
      </article>
      <article class="rounded-2xl border border-slate-200 p-6 transition hover:-translate-y-1 hover:shadow-lg dark:border-slate-800">
        <p class="text-sm font-medium text-teal-600 dark:text-teal-400">Media metadata</p>
        <h2 class="mt-2 text-2xl font-semibold">Media Inspector</h2>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Inspects media-file metadata and generates a Media Manifest Core specification file.</p>
        <div class="mt-4 flex flex-wrap gap-3 text-sm">
          <a class="text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300" href="/projects/media-inspector">Case study</a>
          <a class="text-slate-600 hover:text-teal-600 dark:text-slate-300 dark:hover:text-teal-400" href="https://github.com/steventclarke/media-inspector">GitHub</a>
          <a class="text-slate-600 hover:text-teal-600 dark:text-slate-300 dark:hover:text-teal-400" href="https://mediainspector.stevenclarke.dev">Demo</a>
        </div>
      </article>
      <article class="rounded-2xl border border-slate-200 p-6 transition hover:-translate-y-1 hover:shadow-lg dark:border-slate-800">
        <p class="text-sm font-medium text-teal-600 dark:text-teal-400">Portfolio</p>
        <h2 class="mt-2 text-2xl font-semibold">Portfolio Website</h2>
        <p class="mt-2 text-slate-600 dark:text-slate-300">Astro, TypeScript, Tailwind CSS, AWS S3 + CloudFront, CDK, GitHub Actions with OIDC, and preview deployments.</p>
        <div class="mt-4 flex flex-wrap gap-3 text-sm">
          <a class="text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300" href="/projects/portfolio-website">Case study</a>
          <a class="text-slate-600 hover:text-teal-600 dark:text-slate-300 dark:hover:text-teal-400" href="https://github.com/steventclarke/portfolio">GitHub</a>
          <a class="text-slate-600 hover:text-teal-600 dark:text-slate-300 dark:hover:text-teal-400" href="https://portfolio.stevenclarke.dev">Demo</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

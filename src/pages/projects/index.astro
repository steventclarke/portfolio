---
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPage } from '../../lib/pages';

const { entry, Content } = await getPage('projects');
const { title, description, eyebrow, heading, intro, sections } = entry.data;
const cardsSection = sections.find((section) => section.id === 'projects') ?? sections[0];
const hasBody = Boolean(entry.body?.trim());
---

<BaseLayout title={title} description={description}>
  <section class="space-y-8">
    <PageHero eyebrow={eyebrow} heading={heading} intro={intro} introWidth="3xl" />

    {cardsSection && (
      <div class="grid gap-6 md:grid-cols-2">
        {cardsSection.cards.map((card) => (
          <article class="rounded-2xl border border-slate-200 p-6 transition hover:-translate-y-1 hover:shadow-lg dark:border-slate-800">
            {card.eyebrow && (
              <p class="text-sm font-medium text-teal-600 dark:text-teal-400">{card.eyebrow}</p>
            )}
            <h2 class="mt-2 text-2xl font-semibold">{card.title}</h2>
            <p class="mt-2 text-slate-600 dark:text-slate-300">{card.body}</p>
            <div class="mt-4 flex flex-wrap gap-3 text-sm">
              <a
                class="text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300"
                href={card.href}
              >
                {card.linkLabel}
              </a>
              {card.links.map((link) => (
                <a
                  class="text-slate-600 hover:text-teal-600 dark:text-slate-300 dark:hover:text-teal-400"
                  href={link.href}
                  rel="noopener noreferrer"
                >
                  {link.label}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    )}

    {hasBody && (
      <div class="project-prose">
        <Content />
      </div>
    )}
  </section>
</BaseLayout>

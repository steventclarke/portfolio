---
import BaseLayout from '../../layouts/BaseLayout.astro';

const summary =
  'A strength-training tracker reimagined as an 8-bit pixel-art RPG. Log real lifts, earn XP for working sets, and grow a Tamagotchi-style avatar from skinny to mighty — one codebase for iOS, Android, and web.';

const progress = { completed: 7, total: 8 };
const progressPercent = Math.round((progress.completed / progress.total) * 100);

const statusStyles: Record<string, string> = {
  Complete: 'bg-teal-100 text-teal-800 dark:bg-teal-900/40 dark:text-teal-300',
  'In progress': 'bg-amber-100 text-amber-900 dark:bg-amber-900/40 dark:text-amber-200',
  'Not started': 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400',
};

const constraints = [
  'Must run on iOS, Android, and a real web browser from one codebase.',
  'Offline-only v1: no accounts, no login, local-first data.',
  'Architecture must keep an auth/sync seam so federated login and cloud sync can be added later.',
  'v1 scope: five main lifts (squat, bench, deadlift, overhead press, power clean), weight × reps, warmup flag, rest timer, body-weight entry, history, charts, and gamification.',
  'Out of v1: supersets, dropsets, timed holds, plate calculator, sound, additional characters.',
  'Pixel-art aesthetic with placeholder sprites and a documented sprite-sheet format.',
  'Built solo at roughly 10 hours/week against an end-of-November 2026 MVP target.',
  'Budget: Apple and Google developer licensing costs are prohibitive for now, so a store release remains hypothetical unless the app can be monetized enough to justify the cost.',
];

const successCriteria = [
  'A full workout can be logged on all three platforms without an account or a network connection.',
  'XP is awarded only for working sets, and the avatar advances through 10 stages over 0–1000 XP.',
  'Weekly streak and decay behave correctly for live and retroactively dated workouts.',
  'History and per-lift progress charts reflect logged data accurately.',
  'The static web build is hosted at the production hostname and linked from the portfolio.',
];

const techChoices = [
  {
    choice: 'Expo (React Native) + TypeScript',
    why: 'One codebase for iOS, Android, and web; large ecosystem',
    alternatives: 'Separate native apps, Flutter',
    tradeoff: 'Not fully native; some web-specific quirks',
  },
  {
    choice: 'Expo Router',
    why: 'File-based routing with real URLs on web',
    alternatives: 'React Navigation alone',
    tradeoff: 'Route structure constrains screen/layout organization',
  },
  {
    choice: 'Zustand + repository layer',
    why: 'Small, simple state; persistence kept out of components',
    alternatives: 'Redux, Context-only',
    tradeoff: 'Requires discipline to route all reads/writes through repositories',
  },
  {
    choice: 'AsyncStorage with a single versioned JSON document',
    why: 'Portable on every target with no header or runtime config; ample for a personal log',
    alternatives: 'expo-sqlite (web needs SharedArrayBuffer + COEP/COOP headers)',
    tradeoff: 'Whole-document writes; migrations are manual',
  },
  {
    choice: 'react-native-svg + custom pixel charts',
    why: 'Works in Expo Go and on web; matches the pixel aesthetic exactly',
    alternatives: 'Victory Native (needs Skia and a native dev build)',
    tradeoff: 'Chart primitives must be built by hand',
  },
  {
    choice: 'Reanimated + expo-image',
    why: 'Sprite animation and image handling',
    alternatives: 'Plain Animated for everything',
    tradeoff: 'Web/native behavior can diverge',
  },
  {
    choice: 'Press Start 2P + strict palette',
    why: 'Typographic pixel identity without custom logo assets',
    alternatives: 'Standard sans-serif',
    tradeoff: 'Readability at small sizes needs care',
  },
  {
    choice: 'AWS S3 + CloudFront + Route 53 + ACM via CDK',
    why: 'Managed static hosting inside the existing platform',
    alternatives: 'Netlify, Vercel, EAS Hosting',
    tradeoff: 'Infrastructure work lands before launch',
  },
  {
    choice: 'EAS Build',
    why: 'Managed native builds for iOS/Android',
    alternatives: 'Local Xcode/Gradle builds',
    tradeoff: 'Dependency on EAS plan limits and build minutes',
  },
  {
    choice: 'Jest + React Native Testing Library (planned)',
    why: 'Standard RN testing stack; Maestro later for e2e',
    alternatives: 'No automated tests',
    tradeoff: 'Tests have been deferred, which is a risk',
  },
];

const phases = [
  {
    id: 'P0',
    name: 'Scaffold',
    scope: 'Expo + TS init, Expo Router, lint/format, theme tokens, pixel font, skeleton routes',
    done: 'Runs on iOS, Android, and web',
    status: 'Complete',
  },
  {
    id: 'P1',
    name: 'Data',
    scope:
      'Versioned JSON document, migrations, repositories, seed exercises, sync seam, unit conversion, draft session',
    done: 'Data layer is usable and persisted',
    status: 'Complete',
  },
  {
    id: 'P1.1',
    name: 'Session entry date',
    scope: 'Performed-date model, optional live timestamps, DB v2 migration',
    done: 'Retroactive dates are representable',
    status: 'Complete',
  },
  {
    id: 'P2',
    name: 'Profile + avatar',
    scope: 'Character registry, sprite-sheet loader, stage calculation, profile screen',
    done: 'Avatar renders and responds to XP',
    status: 'Complete',
  },
  {
    id: 'P3',
    name: 'Session log',
    scope:
      'Exercise picker, set entry, rest timer, resume, retroactive date control, duplicate set',
    done: 'A workout can be logged end to end',
    status: 'Complete',
  },
  {
    id: 'P3.1',
    name: 'Session refinements',
    scope:
      'Configurable/persisted timer, navigation, unit-aware tonnage, grouped sets, edit reps, + glyph',
    done: 'Session screen holds up to real use',
    status: 'Complete',
  },
  {
    id: 'P4',
    name: 'History',
    scope: 'List and detail views, retroactively dated sessions',
    done: 'Past sessions are browsable',
    status: 'Complete',
  },
  {
    id: 'P5',
    name: 'Data viz',
    scope: 'Custom SVG pixel charts, per-lift and body-weight screens, manual entry',
    done: 'Progress is visible per lift and body weight',
    status: 'Complete',
  },
  {
    id: 'P5.1',
    name: 'Demo consistency',
    scope: 'Locked top navigation, active-tab highlight, arrow glyph fix',
    done: 'Navigation is consistent on every screen',
    status: 'Complete',
  },
  {
    id: 'P6',
    name: 'Gamification',
    scope:
      'Weekly streak and XP decay, trend indicator, XP-to-next-stage bar, set/workout animations',
    done: 'Training visibly changes the avatar',
    status: 'Complete',
  },
  {
    id: 'P6.1',
    name: 'Session/XP refinements',
    scope:
      'Dedicated rest-timer screen, two-digit reps field, XP = 1 per working set, DB v5 rebuild',
    done: 'XP rewards the intended behavior',
    status: 'Complete',
  },
  {
    id: 'P6.2',
    name: 'IA and stats',
    scope: 'Lean Session page, remove “Log Past Workout”, editable body weight, week-gated decay',
    done: 'Session and Profile have clear, non-duplicated roles',
    status: 'Complete',
  },
  {
    id: 'P7',
    name: 'Hosting & ship',
    scope:
      'P7.1 CDK web hosting + GitHub Actions; P7.2 EAS mobile artifacts to S3; P7.3 polish, accessibility, privacy/support, store metadata, import',
    done: 'Public web URL is live; mobile artifacts are archived',
    status: 'In progress',
  },
];

const nextSteps = [
  {
    label: 'P7.1',
    text: 'infra/ CDK app for preview/prod S3 + CloudFront, SPA fallback, headers, Route 53 alias records, and GitHub Actions deploys.',
  },
  {
    label: 'P7.2',
    text: 'EAS production builds archived with metadata and checksums in a versioned S3 bucket.',
  },
  {
    label: 'P7.3',
    text: 'Responsive web, accessibility, empty states, privacy/support pages, store metadata, and text-file import (post-MVP candidate).',
  },
];

const challenges = [
  {
    title: 'Choosing a storage layer that had to work on the web',
    context:
      'expo-sqlite on web requires SharedArrayBuffer plus COEP/COOP headers on every host, which put the “must run in a browser” constraint at risk.',
    tried: 'Evaluated SQLite for its query power and migration story before committing.',
    resolution:
      'Used a single versioned JSON document in AsyncStorage behind a repository seam. It is portable everywhere with no runtime or header configuration, at the cost of whole-document writes and manual migrations.',
    takeaway:
      'Let the hardest platform constraint drive the storage decision, then isolate it so it can be replaced later.',
  },
  {
    title: 'Charting that fit the pixel aesthetic',
    context:
      'The charts needed to look native to the 8-bit visual language, not like a generic chart library.',
    tried:
      'Victory Native was the obvious choice until its current versions required Skia and a native development build.',
    resolution:
      'Built PixelLineChart and PixelBarChart on react-native-svg, which works in Expo Go and on web. More code, but exact control over the look and no extra native dependency.',
    takeaway: 'A strong aesthetic requirement can simplify the dependency graph.',
  },
  {
    title: 'Making XP reward the right behavior',
    context:
      'The first XP model used total tonnage, which rewarded heavy sets more than consistent training.',
    tried:
      'Kept tonnage as a display metric while questioning what the avatar should actually respond to.',
    resolution:
      'Switched to one XP per working set, independent of weight or reps, and rebuilt stored totals with a DB v5 migration. Warmups are excluded.',
    takeaway:
      'Game mechanics should reward the behavior you want to encourage, not the easiest number to compute.',
  },
  {
    title: 'Retroactive workouts touched more than the session screen',
    context:
      'Users needed to log a workout for a past date, but the original model assumed live sessions with start/end timestamps.',
    tried:
      'Added a user-chosen performed date, made timestamps optional, and threaded the change through drafts, repositories, history, and gamification.',
    resolution:
      'Five database versions later, streak and decay compute from performed dates. The change was correct but rippled through the data model.',
    takeaway:
      'Model time explicitly and early; a user-chosen calendar date is not the same thing as a timestamp.',
  },
  {
    title: 'Session and Profile were doing the same job',
    context:
      'The Gym and Profile pages both showed the avatar and training summary, which made the first screen noisy.',
    tried:
      'Reworked the information architecture after the features existed rather than guessing up front.',
    resolution:
      'The landing page became a lean Session screen with Start/Resume only; Profile owns the avatar and stats. “Log Past Workout” was removed in favor of the session date selector.',
    takeaway:
      'It is fine to revisit IA once you can actually use the product — just keep the change small and deliberate.',
  },
  {
    title: 'Designing UX without a design background',
    context:
      'I have traditionally been a very backend-focused engineer, and I do not have a strong design sense or an inner eye for imagining designs before trying them.',
    tried:
      'Built screens iteratively, using intuition to spot a “design smell” and then reworking the layout or interaction until it felt right.',
    resolution:
      'The result is simpler and more usable than my first attempts, but it took more trial and error than a designer would need. It also gave me much more respect for UX designers and visual-design creatives — there are a lot of subtle choices whose effect on the user experience is not obvious.',
    takeaway:
      'I went into this thinking “how hard can it be” and came out wanting to pursue formal design training, to have at least some framework for approaching visual and UX problems even though design is not my main focus.',
  },
];

const tradeoffs = [
  {
    decision: 'One cross-platform codebase',
    bought: 'Reach on iOS, Android, and web',
    cost: 'Some web-specific behavior and platform testing',
  },
  {
    decision: 'JSON document over SQLite',
    bought: 'Portability and zero runtime config',
    cost: 'Whole-document writes and hand-written migrations',
  },
  {
    decision: 'Custom SVG charts over a chart library',
    bought: 'Exact pixel aesthetic and Expo Go compatibility',
    cost: 'More chart code to build and maintain',
  },
  {
    decision: 'Local-first, no accounts',
    bought: 'Simplicity, privacy, and offline use',
    cost: 'No sync or multi-device story in v1',
  },
  {
    decision: 'Deferring CI, tests, and hosting',
    bought: 'Faster early feature velocity',
    cost: 'Later hardening and a delayed public URL',
  },
  {
    decision: 'Placeholder pixel art',
    bought: 'Focus on mechanics and data model',
    cost: 'Visual polish still pending',
  },
];

const differently = [
  'Build out the support infrastructure as soon as the tech stack was decided, before doing much implementation. It was more fun to keep working on the app, but doing the infrastructure first would have fed those lessons into the plan for my tenant apps and avoided churn and wasted time getting things back in sync.',
  'Put CI/CD and my preferred development workflow in place sooner. Working on the infrastructure project forced me to figure those out; having them earlier would have let me automate a larger share of this app’s development.',
  'Adopt the agent-driven branch/PR review process from the start. I have less experience with front-end implementation than back-end, so more granular checkpoints and detailed review would have helped me learn more from this app. I did not find a good process for that until it was already well along.',
];

const lessons = [
  'Constrain the platform first, then choose tools that fit inside the constraint.',
  'Keep pure domain logic separate from storage and UI; it made the schema changes survivable.',
  'Plan phases as vertical slices so the app stays runnable and demoable.',
  'Reward the behavior, not the proxy metric.',
  'Technical-leaning engineers should have respect for, and some familiarity with, user-experience design. UX design is a whole discipline unto itself and should be treated with respect, because it has a huge impact on the final product.',
];
---

<BaseLayout
  title="Iron Altar"
  description="Iron Altar case study — a strength-training tracker built as an 8-bit pixel-art RPG with Expo, TypeScript, local-first data, and gamification."
>
  <article class="space-y-16">
    <header class="space-y-6">
      <div class="flex flex-wrap items-center gap-3 text-sm font-medium uppercase tracking-[0.3em] text-teal-600 dark:text-teal-400">
        <span>Case study</span>
        <span aria-hidden="true" class="text-slate-400 dark:text-slate-600">
          /
        </span>
        <span>In progress</span>
      </div>
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl">Iron Altar</h1>
      <p class="max-w-3xl text-lg text-slate-600 dark:text-slate-300">{summary}</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-600 dark:text-slate-400">
        <span>
          <strong class="text-slate-900 dark:text-slate-100">Role:</strong> Product Owner, Designer,
          Developer
        </span>
        <span>
          <strong class="text-slate-900 dark:text-slate-100">Timeline:</strong> Oct 2026 – present
        </span>
        <span>
          <strong class="text-slate-900 dark:text-slate-100">Status:</strong>
          <span class="ml-1 rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-900 dark:bg-amber-900/40 dark:text-amber-200">
            In progress
          </span>
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <a
          class="rounded-full border border-slate-300 px-4 py-1 transition hover:border-teal-600 hover:text-teal-600 dark:border-slate-700 dark:hover:border-teal-400 dark:hover:text-teal-400"
          href="https://github.com/steventclarke/iron-altar"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
        <span class="text-slate-500 dark:text-slate-400">Live web demo ships with Phase 7.</span>
      </div>
    </header>

    <section
      aria-labelledby="status-heading"
      class="rounded-3xl border border-slate-200 p-6 sm:p-8 dark:border-slate-800"
    >
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="space-y-2">
          <h2 id="status-heading" class="text-2xl font-semibold tracking-tight sm:text-3xl">
            Status
          </h2>
          <p class="text-slate-600 dark:text-slate-300">
            In progress — P7 Hosting &amp; ship (phase 8 of 8). P0–P6.2 are complete.
          </p>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          <span class="text-3xl font-semibold text-slate-900 dark:text-slate-100">
            {progress.completed}
          </span>
          / {progress.total} major phases complete
        </p>
      </div>
      <div
        class="mt-4 h-2 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800"
        role="progressbar"
        aria-label="Development plan progress"
        aria-valuenow={progress.completed}
        aria-valuemin="0"
        aria-valuemax={progress.total}
      >
        <div
          class="h-full rounded-full bg-teal-600 dark:bg-teal-400"
          style={`width: ${progressPercent}%`}
        ></div>
      </div>
      <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
        Last updated 2026-11-10. The phase-by-phase plan is in section 3.
      </p>
    </section>

    <section aria-labelledby="problem-heading" class="space-y-8">
      <h2 id="problem-heading" class="text-2xl font-semibold tracking-tight sm:text-3xl">
        1. Problem Statement
      </h2>

      <div class="space-y-4">
        <h3 class="text-xl font-semibold">Target user</h3>
        <p class="max-w-3xl text-slate-600 dark:text-slate-300">
          The target user cares about progressive overload and measurable progress in the gym for
          strength and/or bodybuilding. The design appeal is aimed at someone nostalgic for 1980s
          and 1990s video games; the intent is for the app to feel like it is running on a Game Boy
          or a vintage console. Ideally it should be as easy — or easier — to use than a plain text
          notes file, because that is what it is competing with for me as a user. The user also
          likes data visualization to stay motivated and get a sense of progress over time, and the
          gamification is meant to evoke an old-school RPG, a genre that plays very effectively on
          the human desire for progression and achievement.
        </p>
        <p class="max-w-3xl text-slate-600 dark:text-slate-300">
          To be completely honest, I chose to build this application to give myself a project with
          no external integrations, nicely compartmentalized, so I could figure out how to use
          agentic AI spec-driven development on something tangible and connected to my own interests
          — more than out of a driving need to solve this particular problem. Fitness trackers are a
          dime a dozen, but it is a simple problem domain with enough UX design complexity to be
          interesting and challenging.
        </p>
      </div>

      <div class="space-y-4">
        <h3 class="text-xl font-semibold">The problem</h3>
        <p class="max-w-3xl text-slate-600 dark:text-slate-300">
          Today I mostly use a plain text file to track my workouts, partly because I find existing
          tracker apps overly complex and feature-rich, and modern design trends do not always
          appeal to me. I wanted something that makes me feel happy and nostalgic when I open it, is
          very simple to use, but still takes advantage of structured data to provide visualizations
          and historical data. Logging a set should take seconds, work offline, and give something
          back — on iOS, Android, and a real web browser from one codebase.
        </p>
      </div>

      <div class="space-y-4">
        <h3 class="text-xl font-semibold">Why it matters</h3>
        <p class="max-w-3xl text-slate-600 dark:text-slate-300">
          Consistency is the hard part of strength progress. If logging is tedious, people skip it;
          if nothing rewards the behavior, the history never accumulates. A tool that is quick to
          use and visibly responds to training can make the habit stick.
        </p>
        <p class="max-w-3xl text-slate-600 dark:text-slate-300">
          This is also a problem domain I understand well, and the lack of external integrations
          makes it a pure design and implementation challenge. That makes it a good starting point
          for getting up to speed with modern AI spec-driven development and for improving my
          front-end design thinking, so I can be a stronger full-stack contributor.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-2">
        <div class="space-y-4">
          <h3 class="text-xl font-semibold">Constraints</h3>
          <ul class="list-disc space-y-2 pl-5 text-slate-600 dark:text-slate-300">
            {constraints.map((constraint) => (
              <li>{constraint}</li>
            ))}
          </ul>
        </div>
        <div class="space-y-4">
          <h3 class="text-xl font-semibold">Success criteria</h3>
          <ul class="list-disc space-y-2 pl-5 text-slate-600 dark:text-slate-300">
            {successCriteria.map((criterion) => (
              <li>{criterion}</li>
            ))}
          </ul>
          <p class="text-slate-600 dark:text-slate-300">
            For this project, “done enough to ship” means the hosted web URL with basic usability
            and local browser data storage. An actual App Store or Play Store release is
            hypothetical for now: the developer licensing costs for Apple and Google are prohibitive
            for my current goals and budget, unless the app could be monetized enough to justify
            them.
          </p>
        </div>
      </div>
    </section>

    <section aria-labelledby="approach-heading" class="space-y-8">
      <h2 id="approach-heading" class="text-2xl font-semibold tracking-tight sm:text-3xl">
        2. Approach
      </h2>

      <div class="space-y-4">
        <h3 class="text-xl font-semibold">Overview</h3>
        <p class="max-w-3xl text-slate-600 dark:text-slate-300">
          Build a single Expo (React Native) + TypeScript codebase targeting iOS, Android, and web,
          with a local-first data layer and all training logic in pure domain modules. Screens read
          and write through repositories so a future sync backend can slot in without touching the
          UI. Ship the web build first as public evidence, then archive mobile builds and publish
          later.
        </p>
      </div>

      <div class="space-y-4">
        <h3 class="text-xl font-semibold">2.a Technology choices</h3>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
          <table class="w-full min-w-[56rem] text-left text-sm">
            <caption class="sr-only">Technology choices and tradeoffs for Iron Altar</caption>
            <thead class="bg-slate-50 text-slate-700 dark:bg-slate-900 dark:text-slate-300">
              <tr>
                <th scope="col" class="px-4 py-3 font-semibold">
                  Choice
                </th>
                <th scope="col" class="px-4 py-3 font-semibold">
                  Why this
                </th>
                <th scope="col" class="px-4 py-3 font-semibold">
                  Alternatives considered
                </th>
                <th scope="col" class="px-4 py-3 font-semibold">
                  Tradeoff
                </th>
              </tr>
            </thead>
            <tbody>
              {techChoices.map((item) => (
                <tr class="border-t border-slate-200 align-top dark:border-slate-800">
                  <td class="px-4 py-3 font-medium text-slate-900 dark:text-slate-100">
                    {item.choice}
                  </td>
                  <td class="px-4 py-3 text-slate-600 dark:text-slate-300">{item.why}</td>
                  <td class="px-4 py-3 text-slate-600 dark:text-slate-300">{item.alternatives}</td>
                  <td class="px-4 py-3 text-slate-600 dark:text-slate-300">{item.tradeoff}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="max-w-3xl text-slate-600 dark:text-slate-300">
          The choice I am most confident defending is Expo (React Native) + TypeScript. It gives a
          lot of future flexibility for minimal scope expansion, and managing scope well is one of
          the most crucial skills for making sure a team or organization spends its energy and
          resources on the right things.
        </p>
      </div>

      <div class="space-y-4">
        <h3 class="text-xl font-semibold">2.b Development workflow</h3>
        <p class="max-w-3xl text-slate-600 dark:text-slate-300">
          Plan-first, phase-driven development. <code>plan.md</code> is the source of truth:
          resolved decisions, architecture, data model, phased milestones (P0, P1, P1.1, …), and a
          triaged refinement backlog folded into phases. Each phase is a small vertical slice that
          keeps the app runnable. Lint, format, and typecheck are the local gates; the web export is
          the build check. CI/CD and hosting land in P7 rather than at the start.
        </p>
        <p class="max-w-3xl text-slate-600 dark:text-slate-300">
          This was my first project using a spec- and plan-oriented workflow with an AI agent. I
          used OpenCode with the free experimental agent “Big Pickle” because it was free and, from
          what I could see, quite good at acting as the developer and technical subject-matter
          expert while I took on the technical product-owner role. The loop started with a
          plain-English <code>spec.md</code> describing what I wanted to build, some of the UX, and
          some constraints. I asked the agent to create <code>plan.md</code> with a
          clarifying-questions section I could fill in to resolve ambiguities. After that, I would
          prompt the agent to proceed with the current phase and update <code>plan.md</code> to
          record what it completed in each commit.
        </p>
        <p class="max-w-3xl text-slate-600 dark:text-slate-300">
          I was surprised and pleased that the agent interacted with git with little to no
          prompting, which got me thinking about tooling integration. Early on I was just driving
          forward, having the agent commit to <code>main</code> and reviewing the code in my IDE.
          Partway through, as I worked on other projects and discovered better workflows, I
          standardized on branch conventions: the agent creates a branch per phase, pushes it to
          GitHub, and opens a pull request. I leave review comments, and the agent cycles through
          them. That was a game changer for quality control — it lets me review work in digestible
          chunks and catch subtle errors as they arise.
        </p>
        <p class="max-w-3xl text-slate-600 dark:text-slate-300">
          For design iteration I would deploy the app locally and interact with it much like a
          product owner or beta user. When I found something to change, I would prompt the agent to
          add feature refinements to the plan, triage them into the appropriate phase, and tackle
          them when that phase came up. The plan stayed the living source of truth for where the
          project was and what remained.
        </p>
        <p class="max-w-3xl text-slate-600 dark:text-slate-300">
          While working on the portfolio and <code>stevenclarke-infrastructure</code> projects, I
          landed on a reasonable CI/CD approach and replicated it here: any branch can be manually
          deployed to a preview environment, and production deploys from <code>main</code> after a
          manual approval gate. That approximates an enterprise-grade environment scheme and lets me
          test and review the UI on the web while keeping production carefully controlled. GitHub
          Actions with OIDC makes it work.
        </p>
        <p class="max-w-3xl text-slate-600 dark:text-slate-300">
          Working on multiple projects simultaneously with multiple agents surfaced slight
          differences in how each <code>plan.md</code> evolved. By pointing one project’s agent at
          another and asking it to adopt practices from it, I organically converged on a process
          that works across all my projects. Standardizing up front might have been more efficient,
          but the flexible approach let me work on many things at once while learning and improving
          the process as I went.
        </p>
      </div>
    </section>


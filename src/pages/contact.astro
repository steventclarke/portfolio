---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/pages';

const { entry, Content } = await getPage('contact');
const { title, description, eyebrow, heading, intro, contacts } = entry.data;
const hasBody = Boolean(entry.body?.trim());
---

<BaseLayout title={title} description={description}>
  <div class="space-y-6">
    <PageHero eyebrow={eyebrow} heading={heading} intro={intro} />

    <dl class="grid gap-6 sm:grid-cols-2">
      {contacts.map((contact) => (
        <div
          class:list={[
            'rounded-2xl border border-slate-200 p-6 dark:border-slate-800',
            contact.wide && 'sm:col-span-2',
          ]}
        >
          <dt class="text-sm font-medium tracking-[0.2em] text-slate-500 uppercase dark:text-slate-400">
            {contact.label}
          </dt>
          <dd class="mt-2 text-lg">
            <a
              class="text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300"
              href={contact.href}
              rel="noopener noreferrer"
            >
              {contact.value}
            </a>
          </dd>
        </div>
      ))}
    </dl>

    {hasBody && (
      <div class="project-prose">
        <Content />
      </div>
    )}
  </div>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Contact Steven Clarke by email, LinkedIn, or GitHub.">
  <section class="space-y-6">
    <header class="space-y-4">
      <p class="text-sm font-medium uppercase tracking-[0.3em] text-teal-600 dark:text-teal-400">Contact</p>
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Let's talk about senior engineering work.</h1>
      <p class="max-w-2xl text-lg text-slate-600 dark:text-slate-300">
        I am available by email and on LinkedIn and GitHub.
      </p>
    </header>
    <dl class="grid gap-6 sm:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 p-6 dark:border-slate-800">
        <dt class="text-sm font-medium uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Email</dt>
        <dd class="mt-2 text-lg">
          <a class="text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300" href="mailto:steven.t.clarke@gmail.com">steven.t.clarke@gmail.com</a>
        </dd>
      </div>
      <div class="rounded-2xl border border-slate-200 p-6 dark:border-slate-800">
        <dt class="text-sm font-medium uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">LinkedIn</dt>
        <dd class="mt-2 text-lg">
          <a class="text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300" href="https://www.linkedin.com/in/steven-clarke-0647a039/" rel="noopener noreferrer">
            linkedin.com/in/steven-clarke-0647a039
          </a>
        </dd>
      </div>
      <div class="rounded-2xl border border-slate-200 p-6 dark:border-slate-800 sm:col-span-2">
        <dt class="text-sm font-medium uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">GitHub</dt>
        <dd class="mt-2 text-lg">
          <a class="text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300" href="https://github.com/steventclarke" rel="noopener noreferrer">
            github.com/steventclarke
          </a>
        </dd>
      </div>
    </dl>
  </section>
</BaseLayout>

---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/pages';

const { entry, Content } = await getPage('home');
const {
  title,
  description,
  eyebrow,
  heading,
  intro,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  ctas,
  sections,
} = entry.data;

const projectsSection = sections.find((section) => section.id === 'projects') ?? sections[0];
const strengthsSection = sections.find((section) => section.id === 'strengths') ?? sections[1];
const hasBody = Boolean(entry.body?.trim());
---

<BaseLayout title={title} description={description}>
  <PageHero
    eyebrow={eyebrow}
    heading={heading}
    intro={intro}
    ctas={ctas}
    image={image}
    imageAlt={imageAlt}
    imageWidth={imageWidth}
    imageHeight={imageHeight}
  />

  {projectsSection && (
    <section class="mt-16 space-y-6">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          {projectsSection.heading && (
            <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              {projectsSection.heading}
            </h2>
          )}
          {projectsSection.intro && (
            <p class="text-slate-600 dark:text-slate-300">{projectsSection.intro}</p>
          )}
        </div>
        {projectsSection.linkLabel && projectsSection.linkHref && (
          <a
            class="text-sm font-medium text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300"
            href={projectsSection.linkHref}
          >
            {projectsSection.linkLabel}
          </a>
        )}
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {projectsSection.cards.map((card) => (
          <article class="rounded-2xl border border-slate-200 p-6 transition hover:-translate-y-1 hover:shadow-lg dark:border-slate-800">
            {card.eyebrow && (
              <p class="text-sm font-medium text-teal-600 dark:text-teal-400">{card.eyebrow}</p>
            )}
            <h3 class="mt-2 text-xl font-semibold">{card.title}</h3>
            <p class="mt-2 text-slate-600 dark:text-slate-300">{card.body}</p>
            <a
              class="mt-4 inline-flex text-sm font-medium text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300"
              href={card.href}
            >
              {card.linkLabel}
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  {strengthsSection && (
    <section class="mt-16 rounded-3xl border border-slate-200 p-8 dark:border-slate-800">
      <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div class="space-y-4">
          {strengthsSection.heading && (
            <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              {strengthsSection.heading}
            </h2>
          )}
          {strengthsSection.intro && (
            <p class="text-slate-600 dark:text-slate-300">{strengthsSection.intro}</p>
          )}
        </div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {strengthsSection.items.map((item) => (
            <li class="rounded-xl border border-slate-200 px-4 py-3 text-sm dark:border-slate-800">
              {item}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {hasBody && (
    <div class="project-prose mt-12">
      <Content />
    </div>
  )}
</BaseLayout>

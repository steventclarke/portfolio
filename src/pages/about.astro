---
import CtaLinks from '../components/CtaLinks.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/pages';

const { entry, Content } = await getPage('about');
const { title, description, eyebrow, heading, intro, sections } = entry.data;

const bringSection = sections.find((section) => section.id === 'bring') ?? sections[0];
const locationSection = sections.find((section) => section.id === 'location') ?? sections[1];
const hasBody = Boolean(entry.body?.trim());
---

<BaseLayout title={title} description={description}>
  <div class="space-y-6">
    <PageHero eyebrow={eyebrow} heading={heading} intro={intro} introWidth="3xl" />

    <div class="grid gap-8 lg:grid-cols-2">
      {bringSection && (
        <div class="space-y-4">
          {bringSection.heading && (
            <h2 class="text-2xl font-semibold tracking-tight">{bringSection.heading}</h2>
          )}
          <ul class="space-y-3 text-slate-600 dark:text-slate-300">
            {bringSection.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      )}
      {locationSection && (
        <div class="space-y-4">
          {locationSection.heading && (
            <h2 class="text-2xl font-semibold tracking-tight">{locationSection.heading}</h2>
          )}
          {locationSection.body && (
            <p class="text-slate-600 dark:text-slate-300">{locationSection.body}</p>
          )}
          {locationSection.ctas.length > 0 && <CtaLinks ctas={locationSection.ctas} />}
        </div>
      )}
    </div>

    {hasBody && (
      <div class="project-prose">
        <Content />
      </div>
    )}
  </div>
</BaseLayout>

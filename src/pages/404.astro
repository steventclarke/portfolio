---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you are looking for could not be found."
  noindex
>
  <section class="mx-auto max-w-2xl space-y-6 py-12 text-center">
    <p class="text-sm font-medium uppercase tracking-[0.3em] text-teal-600 dark:text-teal-400">
      404
    </p>
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Page not found</h1>
    <p class="text-lg text-slate-600 dark:text-slate-300">
      The page you are looking for may have moved or no longer exists.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        class="rounded-full bg-teal-600 px-6 py-2 text-sm font-medium text-white transition hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-400"
        href="/"
      >
        Go home
      </a>
      <a
        class="rounded-full border border-slate-300 px-6 py-2 text-sm font-medium transition hover:border-teal-600 hover:text-teal-600 dark:border-slate-700 dark:hover:border-teal-400 dark:hover:text-teal-400"
        href="/projects"
      >
        View projects
      </a>
    </div>
  </section>
</BaseLayout>

---
import CtaLinks from '../components/CtaLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/pages';

const { entry, Content } = await getPage('404');
const { title, description, noindex, eyebrow, heading, intro, ctas } = entry.data;
const hasBody = Boolean(entry.body?.trim());
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <section class="mx-auto max-w-2xl space-y-6 py-12 text-center">
    {eyebrow && (
      <p class="text-sm font-medium tracking-[0.3em] text-teal-600 uppercase dark:text-teal-400">
        {eyebrow}
      </p>
    )}
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{heading}</h1>
    {intro.map((paragraph) => (
      <p class="text-lg text-slate-600 dark:text-slate-300">{paragraph}</p>
    ))}
    {ctas.length > 0 && (
      <div class="flex justify-center">
        <CtaLinks ctas={ctas} />
      </div>
    )}
    {hasBody && (
      <div class="project-prose text-left">
        <Content />
      </div>
    )}
  </section>
</BaseLayout>

---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Steven Clarke - Senior Software Engineer" } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Steven Clarke</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-full bg-white text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-teal-600 focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >
    <header class="border-b border-slate-200/60 dark:border-slate-800/80">
      <nav
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6"
        aria-label="Primary"
      >
        <a href="/" class="text-lg font-semibold tracking-tight">Steven Clarke</a>
        <div class="flex flex-wrap items-center gap-4 text-sm font-medium">
          <a class="hover:text-teal-600 dark:hover:text-teal-400" href="/projects">Projects</a>
          <a class="hover:text-teal-600 dark:hover:text-teal-400" href="/about">About</a>
          <a class="hover:text-teal-600 dark:hover:text-teal-400" href="/contact">Contact</a>
          <a class="hover:text-teal-600 dark:hover:text-teal-400" href="/resume.pdf">Resume</a>
        </div>
      </nav>
    </header>
    <main id="main" class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
      <slot />
    </main>
    <footer class="border-t border-slate-200/60 dark:border-slate-800/80">
      <div class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-6 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between sm:px-6 dark:text-slate-400">
        <p>© {new Date().getFullYear()} Steven Clarke</p>
        <div class="flex gap-4">
          <a class="hover:text-teal-600 dark:hover:text-teal-400" href="mailto:steven.t.clarke@gmail.com">Email</a>
          <a class="hover:text-teal-600 dark:hover:text-teal-400" href="https://www.linkedin.com/in/steven-clarke-0647a039/">LinkedIn</a>
          <a class="hover:text-teal-600 dark:hover:text-teal-400" href="https://github.com/steventclarke">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>

---
import CtaLinks from './CtaLinks.astro';

interface Cta {
  label: string;
  href: string;
  variant: 'primary' | 'secondary';
}

interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string[];
  introWidth?: '2xl' | '3xl';
  ctas?: Cta[];
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  eyebrow,
  heading,
  intro = [],
  introWidth = '2xl',
  ctas = [],
  image,
  imageAlt = '',
  imageWidth = 750,
  imageHeight = 750,
} = Astro.props;

const headingClass = image
  ? 'text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl'
  : 'text-4xl font-semibold tracking-tight sm:text-5xl';
---

<section class:list={['grid gap-8', image && 'lg:grid-cols-[1.2fr_0.8fr] lg:items-center']}>
  <div class="space-y-6">
    {eyebrow && (
      <p class="text-sm font-medium tracking-[0.3em] text-teal-600 uppercase dark:text-teal-400">
        {eyebrow}
      </p>
    )}
    <h1 class={headingClass}>{heading}</h1>
    {intro.length > 0 && (
      <div
        class:list={[
          'space-y-4 text-lg text-slate-600 dark:text-slate-300',
          introWidth === '3xl' ? 'max-w-3xl' : 'max-w-2xl',
        ]}
      >
        {intro.map((paragraph, index) => (
          <p class={index === 0 ? 'text-slate-700 dark:text-slate-200' : undefined}>{paragraph}</p>
        ))}
      </div>
    )}
    {ctas.length > 0 && <CtaLinks ctas={ctas} />}
  </div>
  {image && (
    <div class="flex justify-center lg:justify-end">
      <div class="overflow-hidden rounded-3xl border border-slate-200 shadow-lg dark:border-slate-800">
        <img
          src={image}
          alt={imageAlt}
          width={imageWidth}
          height={imageHeight}
          class="h-auto w-full max-w-sm object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  )}
</section>

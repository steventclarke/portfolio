---
interface Cta {
  label: string;
  href: string;
  variant: 'primary' | 'secondary';
}

interface Props {
  ctas: Cta[];
}

const { ctas } = Astro.props;
---

<div class="flex flex-wrap gap-3">
  {ctas.map((cta) => (
    <a
      class:list={[
        'rounded-full px-6 py-2 text-sm font-medium transition',
        cta.variant === 'primary'
          ? 'bg-teal-600 text-white hover:bg-teal-700 dark:bg-teal-500 dark:hover:bg-teal-400'
          : 'border border-slate-300 hover:border-teal-600 hover:text-teal-600 dark:border-slate-700 dark:hover:border-teal-400 dark:hover:text-teal-400',
      ]}
      href={cta.href}
    >
      {cta.label}
    </a>
  ))}
</div>
